# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (create the 'agrismart' database + a limited app role first:
#   CREATE ROLE agrismart_app LOGIN PASSWORD 'change-me';
#   CREATE DATABASE agrismart OWNER agrismart_app;
# )
DATABASE_URL=postgres://agrismart_app:change-me@localhost:5432/agrismart

# Server
PORT=3000

# Agoo SMS (https://developer.agoosms.com). When set, notifications are sent for
# delivery; when unset (or on failure) they still log to /api/notifications.
# AGOOSMS_SENDER_ID must be your platform test sender ID or an approved Sender ID
# name from your Agoo dashboard, else Agoo rejects the request.
AGOOSMS_API_KEY=
AGOOSMS_SENDER_ID=
AGOOSMS_BASE_URL=https://api.agoosms.com

# Auth: phone/email + password (bcryptjs) and phone OTP. OTP codes expire after this many
# minutes and are sent via SMS when AGOOSMS_API_KEY is set, otherwise logged.
OTP_EXPIRY_MIN=10

# JWT signing secret - set a long random value in production.
# Run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"` to generate one.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d


GOOGLE_CLIENT_ID=dev-only-change-me
GOOGLE_SECRET_ID=dev-only-change-me

# Paystack (https://paystack.com) for buyer charges + escrow payouts.
# These are the LIVE/API keys for GHS (Ghana). When PAYSTACK_SECRET_KEY is unset
# the payment pipeline runs in a simulated mode (charges succeed instantly, funds
# are held/released in the ledger only) so the full flow works before keys exist.
# Set PAYSTACK_SIMULATED=1 to force simulation even when a key is present — handy
# for deterministic test/staging runs that must never touch the Paystack API.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=GHS
# PAYSTACK_SIMULATED=1